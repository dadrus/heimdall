set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

OBS := env_var_or_default("OBS", "false")
RULE_PROVIDER := env_var_or_default("RULE_PROVIDER", "kubernetes")
DASHBOARD_PORT := "8080"
GRAFANA_PORT := "3000"
STORAGE_PORT := "9001"

default:
  @just --list

_validate_bool NAME VALUE:
  @if [[ "{{VALUE}}" != "true" && "{{VALUE}}" != "false" ]]; then \
    echo "ERROR: {{NAME}} must be 'true' or 'false'" >&2; exit 1; \
  fi

_validate_rule_provider:
  @if [[ "{{RULE_PROVIDER}}" != "kubernetes" && "{{RULE_PROVIDER}}" != "http_endpoint" && "{{RULE_PROVIDER}}" != "cloud_blob" ]]; then \
    echo "ERROR: RULE_PROVIDER must be 'kubernetes', 'http_endpoint' or 'cloud_blob'" >&2; exit 1; \
  fi

validate:
  tofu -chdir=cluster/local init -backend=false
  tofu -chdir=cluster/local validate
  tofu -chdir=deployment/local init -backend=false
  tofu -chdir=deployment/local validate

init:
  tofu -chdir=cluster/local init
  tofu -chdir=deployment/local init

# Print the local kubeconfig path, e.g. export KUBECONFIG="$(just kubeconfig)".
kubeconfig:
  @tofu -chdir=cluster/local output -raw kubeconfig_path

create-local-cluster:
  tofu -chdir=cluster/local init
  tofu -chdir=cluster/local apply -auto-approve

_install_demo CONTROLLER GATEWAY GLOBAL RULES_BUCKET="false" OBS_BUCKETS="false": (_validate_bool "OBS" OBS) (_validate_bool "GATEWAY" GATEWAY) (_validate_bool "GLOBAL" GLOBAL) (_validate_bool "RULES_BUCKET" RULES_BUCKET) (_validate_bool "OBS_BUCKETS" OBS_BUCKETS) _validate_rule_provider create-local-cluster
  #!/usr/bin/env bash
  set -euo pipefail
  kubeconfig="$(tofu -chdir=cluster/local output -raw kubeconfig_path)"
  if [[ ! -f "$kubeconfig" ]]; then
    echo "ERROR: kubeconfig not found after local cluster apply" >&2
    exit 1
  fi

  s3_endpoint="$(tofu -chdir=cluster/local output -raw s3_endpoint)"
  storage_namespace="$(tofu -chdir=cluster/local output -raw storage_namespace)"
  pod_cidrs="$(tofu -chdir=cluster/local output -json pod_cidrs)"
  node_cidrs="$(tofu -chdir=cluster/local output -json node_cidrs)"

  tofu -chdir=deployment/local init
  tofu -chdir=deployment/local apply -auto-approve \
    -var="kubeconfig_path=$kubeconfig" \
    -var="ingress_controller={{CONTROLLER}}" \
    -var="gateway_api_enabled={{GATEWAY}}" \
    -var="global_integration_enabled={{GLOBAL}}" \
    -var="rules_bucket_enabled={{RULES_BUCKET}}" \
    -var="observability_buckets_enabled={{OBS_BUCKETS}}" \
    -var="observability_enabled={{OBS}}" \
    -var="rule_provider={{RULE_PROVIDER}}" \
    -var="s3_endpoint=$s3_endpoint" \
    -var="storage_namespace=$storage_namespace" \
    -var="trusted_proxy_cidrs=$pod_cidrs" \
    -var="node_cidrs=$node_cidrs"

# Quickstarts: choose your preferred ingress controller or Gateway API integration.
install-nginx-demo: (_install_demo "nginx" "false" "false")
install-nginx-global-demo: (_install_demo "nginx" "false" "true")
install-contour-demo: (_install_demo "contour" "false" "true")
install-haproxy-demo: (_install_demo "haproxy" "false" "false")
install-haproxy-global-demo: (_install_demo "haproxy" "false" "true")
install-emissary-demo: (_install_demo "emissary" "false" "true")
install-envoygw-demo: (_install_demo "envoy-gateway" "true" "true")
install-traefik-ingress-demo: (_install_demo "traefik" "false" "true")
install-traefik-ingress-route-demo: (_install_demo "traefik" "false" "false")
install-traefik-gw-demo: (_install_demo "traefik" "true" "true")
install-istio-ingress-gw-demo: (_install_demo "istio" "false" "false")
install-istio-gw-demo: (_install_demo "istio" "true" "false")

# Quick overview of the local cluster.
status:
  #!/usr/bin/env bash
  set -euo pipefail

  kubeconfig="$(tofu -chdir=cluster/local output -raw kubeconfig_path)"

  kubectl --kubeconfig "$kubeconfig" get nodes
  kubectl --kubeconfig "$kubeconfig" get pods -A

# Open Headlamp on localhost:8080 (local demo; cluster-admin auto-login).
headlamp-dashboard:
  #!/usr/bin/env bash
  set -euo pipefail

  kubeconfig="$(tofu -chdir=cluster/local output -raw kubeconfig_path)"
  namespace="$(tofu -chdir=cluster/local output -raw headlamp_namespace)"
  service="$(tofu -chdir=cluster/local output -raw headlamp_service_name)"
  port="$(tofu -chdir=cluster/local output -raw headlamp_service_port)"

  exec kubectl --kubeconfig "$kubeconfig" -n "$namespace" \
    port-forward --address=127.0.0.1 "svc/$service" "{{DASHBOARD_PORT}}:$port"

# Open Grafana on localhost:3000 (requires OBS=true).
observability-dashboard:
  #!/usr/bin/env bash
  set -euo pipefail

  kubeconfig="$(tofu -chdir=cluster/local output -raw kubeconfig_path)"

  exec kubectl --kubeconfig "$kubeconfig" -n monitoring \
    port-forward --address=127.0.0.1 svc/grafana-service "{{GRAFANA_PORT}}:3000"

# Open the RustFS development console on localhost:9001.
storage-dashboard:
  #!/usr/bin/env bash
  set -euo pipefail

  kubeconfig="$(tofu -chdir=cluster/local output -raw kubeconfig_path)"
  namespace="$(tofu -chdir=cluster/local output -raw storage_namespace)"
  service="$(tofu -chdir=cluster/local output -raw rustfs_service_name)"
  port="$(tofu -chdir=cluster/local output -raw rustfs_console_port)"

  exec kubectl --kubeconfig "$kubeconfig" -n "$namespace" \
    port-forward --address=127.0.0.1 "svc/$service" "{{STORAGE_PORT}}:$port"

# Remove only applications and monitoring; keep the kind cluster.
delete-demo:
  #!/usr/bin/env bash
  set -euo pipefail

  kubeconfig="$(tofu -chdir=cluster/local output -raw kubeconfig_path)"

  pod_cidrs="$(tofu -chdir=cluster/local output -json pod_cidrs)"
  node_cidrs="$(tofu -chdir=cluster/local output -json node_cidrs)"

  tofu -chdir=deployment/local init
  tofu -chdir=deployment/local destroy -auto-approve \
    -var="kubeconfig_path=$kubeconfig" \
    -var="trusted_proxy_cidrs=$pod_cidrs" \
    -var="node_cidrs=$node_cidrs"

# Remove the application first, then the kind cluster.
delete-local-cluster: delete-demo
  tofu -chdir=cluster/local destroy -auto-approve
